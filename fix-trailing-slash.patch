From 00d5d32c4521789f8c6e5a1b2c3d4e5f6a7b8c9d Mon Sep 17 00:00:00 2001
From: Qwen-Coder <qwen-coder@alibabacloud.com>
Date: Fri, 16 Jan 2026 15:00:00 +0200
Subject: [PATCH] fix: update svelte.config.js for Vercel deployment

- Add trailingSlash configuration for consistent URL handling
- Update adapter configuration for better Vercel compatibility

---
 svelte.config.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/svelte.config.js b/svelte.config.js
index 283533e..newhash 100644
--- a/svelte.config.js
+++ b/svelte.config.js
@@ -19,6 +19,9 @@ const config = {
     }),
     paths: { base, relative: false }, // Changed relative to false for Vercel
     alias: {
       '$lib': 'src/lib',
       '$lib/*': 'src/lib/*'
     },
     prerender: {
       handleHttpError: 'warn',
       handleMissingId: 'warn',
       handleUnseenRoutes: 'warn'
     },
+    trailingSlash: 'never' // Ensure consistent URL handling
   }
 };
 
 export default config;