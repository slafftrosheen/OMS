# Réclame Fabriek OMS environment template. Never put live secrets here.
# Only PUBLIC_* values are shipped to browser bundles. Provider credentials stay server-side.

# ─── Application topology ──────────────────────────────────────────────────
OMS_HOST=100.98.202.69
NAS_HOST=100.98.202.70
FRONTEND_HOST=100.98.202.69
VITE_HMR_HOST=100.98.202.69

# ─── OpenRouter model API ──────────────────────────────────────────────────
# R&D members can set the system-wide key in Settings (encrypted in Supabase Vault).
# OPENROUTER_API_KEY is an optional server-side fallback. Never prefix it PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=120000

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_HOST=100.98.202.69
SUPABASE_PORT=8000
SUPABASE_DB_PORT=54322
SUPABASE_URL=http://100.98.202.69:8000
PUBLIC_SUPABASE_URL=http://100.98.202.69:8000
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ─── Public application URLs ────────────────────────────────────────────────
PUBLIC_BASE_URL=http://100.98.202.69
PUBLIC_APP_URL=http://100.98.202.69
PUBLIC_APP_NAME=Réclame Fabriek OMS
PUBLIC_WS_URL=ws://100.98.202.69:8000

# ─── AI Lab feature flags ──────────────────────────────────────────────────
PUBLIC_AILAB_ENABLED=true
PUBLIC_AILAB_CHAT_ENABLED=true
PUBLIC_AILAB_CANVAS_ENABLED=true
PUBLIC_AILAB_STATION_TOOLS_ENABLED=true
PUBLIC_AILAB_RUNS_ENABLED=true
AILAB_RATELIMIT_PER_MIN=30

# ─── Storage / application queues ─────────────────────────────────────────
STORAGE_BUCKET_FILES=files
STORAGE_BUCKET_STATION=station-attachments
JOB_QUEUE_TICK_MS=2000
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_MS=900000

# ─── Search and crawling tools (application-owned tools; no local AI) ───────
SEARCH_BACKEND=searxng
SEARCH_BACKEND_URL=http://100.98.202.69:8888
SEARCH_DEFAULT_LANG=en
CRAWL_USER_AGENT=ReclameFabriek-OMS/1.0
CRAWL_MAX_BYTES=2000000
CRAWL_TIMEOUT_MS=15000
BRAND_CRAWLER_BASE_URL=https://reclamefabriek.eu

# ─── Production calculator defaults ────────────────────────────────────────
LUMIGRID_PWM_HZ=24000
LUMIGRID_GAMMA=2.2
LUMIGRID_PWM_BITS=16
LED_STRIP_VOLTS=24
LED_STRIP_LEDS_PER_M=60
LED_STRIP_MA_PER_LED=60
LED_MATRIX_HZ=60
LED_STRIP_MAX_DROP=0.6
COPPER_RHO=0.0175

# ─── HTTP/runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
HTTP_PORT=3000
TRUST_PROXY=true
BODY_LIMIT=25M
MAX_HTTP_HEADER=16384

# ─── Backups / observability / mail ────────────────────────────────────────
BACKUP_REMOTE_PATH=backup@100.98.202.70:/mnt/oms-backups
BACKUP_RETENTION_DAYS=30
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@reclamefabriek.local

# Never commit the populated .env. PUBLIC_* values are browser-visible.