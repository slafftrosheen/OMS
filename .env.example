# =============================================================================
#  Réclame Fabriek OMS — single source of truth for ALL configuration
# =============================================================================
#  Copy to `.env` and edit. Every IP, key, model, port, timeout, bucket and
#  feature flag the entire stack needs lives in this file. There is no other
#  config file and no hardcoded production value anywhere in the codebase.
#
#  Code reads this file via:
#    - SvelteKit:    $env/dynamic/private  +  $env/dynamic/public
#    - Workers:      process.env (loaded with `dotenv/config`)
#    - Edge Funcs:   Deno.env.get(...)
#
#  Variables prefixed PUBLIC_ are the ONLY ones shipped to the browser bundle.
#
#  Hardware topology (production):
#    ai1   100.93.147.108   Win11, RTX 5080 16GB, 32GB RAM, Core Ultra 7
#    ai2   100.93.147.109   Win11, RTX 5080 16GB, 32GB RAM, Core Ultra 7
#    oms   100.98.202.69    Pi5 Bookworm, 1TB NVMe (Supabase + frontend)
#    nas   100.98.202.70    Pi5 Bookworm, 1TB NVMe (backups)
# =============================================================================


# ─── Tailscale topology ───────────────────────────────────────────────────────
# Override these when Tailscale IPs rotate. The Pi5 production server hosts
# Supabase AND the SvelteKit frontend; the second Pi5 is a backup target.

OMS_HOST=100.98.202.69
NAS_HOST=100.98.202.70
FRONTEND_HOST=100.98.202.69
VITE_HMR_HOST=100.98.202.69


# ─── AI swarm — node fleet ───────────────────────────────────────────────────
# The swarm router (src/lib/server/ai/swarm.ts) reads this list and dispatches
# jobs based on capability tags + current load + model warmth.
#
# Capability tags (comma-separated, no spaces):
#   reasoning   — long-form chat, tool calling, planning
#   vision      — image / PDF page understanding
#   coder       — code generation, math
#   embed       — dense text / image embeddings
#   rerank      — cross-encoder reranking
#   image-gen   — diffusion (Flux, SDXL)
#   mesh-gen    — 3D mesh from image (TRELLIS, Hunyuan3D)
#   asr         — speech-to-text (whisper)
#   tts         — text-to-speech (kokoro, piper)
#   colpali     — late-interaction document-as-image retrieval
#
# Format: NODE<n>_HOST / NODE<n>_PORT / NODE<n>_LABEL / NODE<n>_CAPS

NODE1_HOST=100.93.147.108
NODE1_PORT=11434
NODE1_LABEL=ai1
NODE1_CAPS=reasoning,vision,coder,embed
NODE1_WEIGHT=1.0
NODE1_VRAM_GB=16

NODE2_HOST=100.93.147.109
NODE2_PORT=11434
NODE2_LABEL=ai2
NODE2_CAPS=image-gen,mesh-gen,asr,tts,rerank,colpali
NODE2_WEIGHT=1.0
NODE2_VRAM_GB=16

# Sidecar services (Python FastAPI servers running on each AI node next to
# Ollama). These are NOT Ollama — they expose REST endpoints for things Ollama
# doesn't do (Flux, TRELLIS, ColQwen2, Whisper, Kokoro, BGE reranker).

# AI node 1 sidecar (text/vision auxiliaries)
NODE1_SIDECAR_URL=http://100.93.147.108:8800

# AI node 2 sidecar (generative + media)
NODE2_SIDECAR_URL=http://100.93.147.109:8800

# Open WebUI (ships with Ollama, exposed for power users)
PUBLIC_OLLAMA_WEBUI_URL=http://100.93.147.108:3000


# ─── AI swarm — model catalog ────────────────────────────────────────────────
# Every task has a PRIMARY model and a FALLBACK model. The router falls back
# automatically on timeout, OOM, or model-not-loaded errors.
#
# All chat/reasoning models below are tool-calling-capable (verified). DeepSeek-R1
# distills are NOT used because their distill variants don't reliably support
# native function/tool calling — Qwen3 with thinking mode replaces them and gives
# the same chain-of-thought quality plus working tool calls.
#
# Uncensored ("abliterated") variants come from huihui-ai (text), bartowski +
# mradermacher + noctrex (GGUF mirrors). Pull commands are in
# scripts/ai/pull-models-node[12].ps1.
#
# Sizing target: each model fits in 16 GB VRAM at the listed quant.
#
# Tag formats:
#   * `name:tag`           → Ollama official library
#   * `user/name:tag`      → Ollama community namespace (huihui_ai/, etc.)
#   * `hf.co/<repo>:<q>`   → any GGUF on Hugging Face (Ollama auto-converts)

# --- Router (fast classifier — Cohere's RAG/tool-calling specialist) --------
# Command-R7B is purpose-built for RAG + tool use; the abliterated Qwen3-4B
# is the unrestricted fallback.
ROUTER_MODEL=command-r7b:latest
ROUTER_MODEL_FALLBACK=hf.co/bartowski/huihui-ai_Qwen3-4B-abliterated-GGUF:Q5_K_M

# --- Reasoning (Qwen3 thinking mode — replaces DeepSeek-R1) ----------------
# Qwen3 supports BOTH tool calling AND chain-of-thought thinking natively
# (toggle with /think and /no_think). Q4_K_M for the 14B fits in 9 GB.
REASONING_MODEL=hf.co/bartowski/huihui-ai_Qwen3-14B-abliterated-GGUF:Q4_K_M
REASONING_MODEL_FALLBACK=hf.co/mradermacher/Huihui-Qwen3-30B-A3B-Instruct-2507-abliterated-GGUF:Q3_K_M

# --- General chat (default for /api/ai/chat — lighter prompts, no thinking) -
CHAT_MODEL=hf.co/bartowski/huihui-ai_Qwen3-14B-abliterated-GGUF:Q4_K_M
CHAT_MODEL_FALLBACK=qwen3:14b

# --- Coder / engineering math (tool calling fixed in Ollama for Qwen3-Coder) -
ENGINEER_MODEL=hf.co/mradermacher/Huihui-Qwen3-Coder-30B-A3B-Instruct-abliterated-GGUF:Q4_K_M
ENGINEER_MODEL_FALLBACK=qwen3-coder:30b

# --- Vision (PDF/image extraction, multimodal chat with tool calls) --------
VISION_MODEL=huihui_ai/qwen3-vl-abliterated:8b-instruct
VISION_MODEL_FALLBACK=qwen3-vl:8b

# --- Math / engineering brainstorm (Qwen3 thinking handles this; alias) ----
MATH_MODEL=hf.co/bartowski/huihui-ai_Qwen3-14B-abliterated-GGUF:Q4_K_M
MATH_MODEL_FALLBACK=qwen3:14b

# --- Default / "hands" agent (used by analyze-order, generate-description) -
OLLAMA_DEFAULT_MODEL=hf.co/bartowski/huihui-ai_Qwen3-14B-abliterated-GGUF:Q4_K_M
OLLAMA_DEFAULT_MODEL_FALLBACK=qwen3:14b

# --- Embeddings (dense text retrieval, multilingual NL/EN/DE) --------------
EMBED_MODEL=bge-m3
EMBED_MODEL_FALLBACK=nomic-embed-text
EMBED_DIM=1024
EMBED_DIM_FALLBACK=768

# --- Cross-modal embeddings (image content + text query) -------------------
EMBED_IMAGE_MODEL=nomic-embed-vision-v1.5
EMBED_IMAGE_DIM=768

# --- Reranker (cross-encoder, runs on the sidecar, not Ollama) -------------
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_FALLBACK=jinaai/jina-reranker-v2-base-multilingual

# --- ColPali / ColQwen2 (document-as-image late interaction) ---------------
COLPALI_MODEL=vidore/colqwen2-v1.0

# --- ASR (whisper on faster-whisper) ---------------------------------------
ASR_MODEL=large-v3-turbo
ASR_MODEL_FALLBACK=large-v3

# --- TTS -------------------------------------------------------------------
TTS_MODEL=hexgrad/Kokoro-82M
TTS_MODEL_FALLBACK=rhasspy/piper-voices

# --- Image generation (Flux family) ----------------------------------------
IMAGE_MODEL=black-forest-labs/FLUX.1-dev
IMAGE_MODEL_FALLBACK=black-forest-labs/FLUX.1-schnell
IMAGE_QUANT=fp8

# --- Mesh / 3D generation --------------------------------------------------
MESH_MODEL=microsoft/TRELLIS-image-large
MESH_MODEL_FALLBACK=tencent/Hunyuan3D-2.1

# --- Background removal / matting -----------------------------------------
MATTING_MODEL=briaai/RMBG-2.0
MATTING_MODEL_FALLBACK=ZhengPeng7/BiRefNet

# --- Music / SFX (optional) -----------------------------------------------
MUSIC_MODEL=facebook/musicgen-small


# ─── Ollama tuning ────────────────────────────────────────────────────────────
OLLAMA_TIMEOUT_MS=120000
OLLAMA_PROBE_TIMEOUT_MS=3000
# Server jobs keep models warm; CAD workstation sets 0s to free VRAM.
OLLAMA_KEEP_ALIVE=10m
# Context window. Qwen3 14B supports 32k natively, 128k with YaRN.
OLLAMA_NUM_CTX=32768
# Generation cap. Qwen3 thinking mode emits long <think> blocks before answers.
OLLAMA_NUM_PREDICT=4096


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Production is self-hosted Supabase on the Pi5 OMS server. Defaults assume
# the bundled docker-compose deployment (api → 8000, db → 54322).

SUPABASE_HOST=100.98.202.69
SUPABASE_PORT=8000
SUPABASE_DB_PORT=54322
SUPABASE_URL=http://100.98.202.69:8000

PUBLIC_SUPABASE_URL=http://100.98.202.69:8000
PUBLIC_SUPABASE_ANON_KEY=replace-me-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# Direct postgres connection (used by the AI orchestrator's "dumb tool" path).
DATABASE_URL=postgresql://postgres:postgres@100.98.202.69:54322/postgres


# ─── Public app URLs ──────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://100.98.202.69
PUBLIC_APP_URL=http://100.98.202.69
PUBLIC_APP_NAME=Réclame Fabriek OMS
# WebSocket proxy target.
PUBLIC_WS_URL=ws://100.98.202.69:8000


# ─── Reclame AI Lab — feature flags + behaviour ──────────────────────────────
# Toggle individual AI Lab surfaces without removing routes.

PUBLIC_AILAB_ENABLED=true
PUBLIC_AILAB_CHAT_ENABLED=true
PUBLIC_AILAB_KNOWLEDGE_ENABLED=true
PUBLIC_AILAB_FORGE_ENABLED=true
PUBLIC_AILAB_CANVAS_ENABLED=true
PUBLIC_AILAB_STATION_TOOLS_ENABLED=true
PUBLIC_AILAB_RUNS_ENABLED=true

# Knowledge ingestion
KNOWLEDGE_MAX_FILE_MB=200
KNOWLEDGE_CHUNK_SIZE=2500
KNOWLEDGE_CHUNK_OVERLAP=250
KNOWLEDGE_PDF_RENDER_DPI=200
# How many top chunks the orchestrator passes to the LLM per RAG retrieval.
KNOWLEDGE_TOPK=8
# Reranker top-N (subset of TOPK after vector retrieval).
KNOWLEDGE_RERANK_TOPN=4

# Forge generation defaults
FORGE_IMAGE_STEPS=28
FORGE_IMAGE_GUIDANCE=3.5
FORGE_IMAGE_MAX_WIDTH=1536
FORGE_IMAGE_MAX_HEIGHT=1536
FORGE_MESH_STEPS=50

# Job queue
JOB_QUEUE_TICK_MS=2000
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_MS=900000

# Rate limit (AI Lab user-facing endpoints)
AILAB_RATELIMIT_PER_MIN=30


# ─── Storage buckets ──────────────────────────────────────────────────────────
STORAGE_BUCKET_FILES=files
STORAGE_BUCKET_STATION=station-attachments
STORAGE_BUCKET_KNOWLEDGE=knowledge
STORAGE_BUCKET_FORGE=forge


# ─── Crawler / RAG ────────────────────────────────────────────────────────────
BRAND_CRAWLER_BASE_URL=https://reclamefabriek.eu


# ─── CSP allow-list (svelte.config.js) ────────────────────────────────────────
# Comma-separated list of origins added to connect-src. Leave empty to use the
# default list synthesised from NODE*_HOST + sidecars + SUPABASE_HOST.
# CSP_CONNECT_SRC=


# ─── Backups (scripts/backup.sh → NAS) ────────────────────────────────────────
BACKUP_REMOTE_PATH=backup@100.98.202.70:/mnt/oms-backups
# 32-byte hex secret. Generate with: openssl rand -hex 32
# BACKUP_KEY=
BACKUP_RETENTION_DAYS=30


# ─── Sentry (optional) ────────────────────────────────────────────────────────
PUBLIC_SENTRY_DSN=
SENTRY_DSN=


# ─── Email notifications (optional) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@reclamefabriek.local


# ─── pg_cron auto-embed bridge ────────────────────────────────────────────────
# Set ONCE on the Postgres instance, NOT in this file:
#
#   ALTER DATABASE postgres SET app.auto_embed_url =
#       'http://100.98.202.69:8000/functions/v1/auto-embed';
#   ALTER DATABASE postgres SET app.supabase_service_role_key = '<key>';


# ─── Notes ────────────────────────────────────────────────────────────────────
#  1. NEVER commit the populated .env — it's gitignored.
#  2. PUBLIC_* vars are exposed to the browser. Everything else is server-only.
#  3. Rotate Tailscale IPs by editing OMS_HOST / NODE*_HOST. Every consumer
#     (orchestrator, swarm router, CSP, health probes, sidecars, Vite HMR)
#     picks up the new value automatically — no code edits required.
#  4. To add a third AI node, append NODE3_HOST + NODE3_PORT + NODE3_CAPS.
#     The swarm router auto-discovers any NODE<n>_* set up to NODE9.
