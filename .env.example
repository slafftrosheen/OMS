# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
PUBLIC_SUPABASE_URL=your_supabase_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================
# QWEN AI CONFIGURATION (Optional)
# ==============================================
# Get API key from: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=your_qwen_api_key_here

# Singapore region (international)
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Beijing region (China) - use this instead if in China:
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model selection: qwen-plus, qwen-turbo, qwen-max
QWEN_MODEL=qwen-plus

# ==============================================
# FILE UPLOAD CONFIGURATION (Optional)
# ==============================================
# Maximum file size in bytes (50MB default)
MAX_FILE_SIZE=52428800

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=.pdf,.cdr,.jpg,.png,.svg

# Upload directory (relative to project root)
UPLOAD_DIR=uploads

# ==============================================
# APPLICATION SETTINGS
# ==============================================
NODE_ENV=development
PUBLIC_BASE_PATH=
VITE_API_URL=http://localhost:5173

# Session secret for authentication (generate random string)
SESSION_SECRET=your_random_session_secret_here

# Enable debug mode
DEBUG=false
