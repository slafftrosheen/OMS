# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Self-hosted Supabase on Pi 5 (reclame-supabase.local)

# Your local Supabase URL
PUBLIC_SUPABASE_URL="http://reclame-supabase.local:8000"

# Your Supabase anonymous/public key (safe to expose to client)
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your Supabase service role key (⚠️ KEEP SECRET - Server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public URL where your application is hosted (K3s cluster)
PUBLIC_BASE_URL="http://reclame-orch.local"
PUBLIC_APP_URL="http://reclame-orch.local"

# Application display name
PUBLIC_APP_NAME="OMS - Order Management System"

# =============================================================================
# MONITORING / SENTRY (Optional)
# =============================================================================

# Public DSN (for client-side error tracking)
PUBLIC_SENTRY_DSN=

# Private DSN (for server-side error tracking)
SENTRY_DSN=

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
# Required if you want to send email notifications

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourcompany.com

# =============================================================================
# AI / HIVEMIND (Optional, runs on the Tailnet AI node)
# =============================================================================
# DASHSCOPE/Qwen integration was removed (Phase 4). The Hivemind orchestrator
# now talks to Ollama directly. Leave the variables below empty in dev — the
# orchestrator falls back to the Tailscale defaults documented in
# src/lib/server/ai/orchestrator.ts and src/lib/server/ai/ollama-client.ts.

# Ollama endpoint base (no trailing /api).  Default: http://100.93.147.108:11434
# OLLAMA_URL=http://100.93.147.108:11434
# Default chat model used by the small endpoints (analyze-order, generate-description)
# OLLAMA_DEFAULT_MODEL=qwen2.5-coder:14b
# Embedding model used by the auto-embed Edge Function and the crawler
# EMBED_MODEL=nomic-embed-text
# Per-request hard timeout for non-streaming Ollama calls (ms).  Default: 60000
# OLLAMA_TIMEOUT_MS=60000

# DATABASE_URL is required by the orchestrator's tool-calling loop
# DATABASE_URL=postgresql://postgres:postgres@reclame-supabase.local:54322/postgres

# pg_cron auto-embed bridge (set ONCE on the Postgres instance, not in .env):
#   ALTER DATABASE postgres
#       SET app.auto_embed_url = 'http://reclame-supabase.local:54321/functions/v1/auto-embed';
#   ALTER DATABASE postgres
#       SET app.supabase_service_role_key = '<service-role-key>';

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Node environment (usually set automatically)
# NODE_ENV=development

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control (it's in .gitignore)
# 3. Variables starting with PUBLIC_ are exposed to the client
# 4. Other variables are server-side only
# 5. Supabase runs on reclame-supabase.local:8000 (Pi 5)
# 6. App runs on reclame-orch.local (K3s cluster)
#
