# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous/public key (safe to expose to client)
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your Supabase service role key (⚠️ KEEP SECRET - Server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# LEGACY SUPABASE VARIABLES (Optional - for backwards compatibility)
# =============================================================================
# These are kept for compatibility with older code
# You can set these to the same values as above, or use the PUBLIC_ versions

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Vite-style variables (legacy - use PUBLIC_ versions instead)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public URL where your application is hosted
PUBLIC_APP_URL=http://localhost:5173

# Application display name
PUBLIC_APP_NAME="OMS - Order Management System"

# =============================================================================
# MONITORING / SENTRY (Optional)
# =============================================================================
# Get your DSN from: https://sentry.io/

# Public DSN (for client-side error tracking)
PUBLIC_SENTRY_DSN=

# Private DSN (for server-side error tracking - often same as public)
SENTRY_DSN=

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
# Required if you want to send email notifications
# For Gmail: Use an App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourcompany.com

# =============================================================================
# AI FEATURES (Optional)
# =============================================================================
# Required if you want to use AI-powered features

DASHSCOPE_API_KEY=your-dashscope-key

# =============================================================================
# PWA / PUSH NOTIFICATIONS (Optional)
# =============================================================================
# Required if you want to enable web push notifications
# Generate VAPID keys at: https://vapidkeys.com/

# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Node environment (usually set automatically)
# NODE_ENV=development

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control (it's in .gitignore)
# 3. For production, set these as environment variables in your hosting platform
# 4. Variables starting with PUBLIC_ are exposed to the client
# 5. Other variables are server-side only
#
# For more details, see: docs/environment-variables.md
