# =============================================================================
#  Réclame Fabriek OMS — environment template
# =============================================================================
#  Copy this file to `.env` and edit values. Every IP, key, model name, port
#  and timeout the app needs is here. Code reads from `.env` via:
#    - SvelteKit:  $env/dynamic/private  +  $env/dynamic/public
#    - Workers:    process.env (loaded with `dotenv/config`)
#    - Supabase Edge Functions:  Deno.env.get(...)
#
#  Variables prefixed PUBLIC_ are the ONLY ones exposed to the client bundle.
# =============================================================================


# ─── Tailscale topology ───────────────────────────────────────────────────────
#  CLAUDE.md documents the canonical addresses; defaults below match it.
#  Override when your Tailscale IPs rotate.

OLLAMA_HOST=100.93.147.108
OLLAMA_PORT=11434
# Optional: full URL.  When unset, derived from OLLAMA_HOST + OLLAMA_PORT.
OLLAMA_URL=http://100.93.147.108:11434
# Open WebUI sitting next to Ollama (used by /ai-dashboard's "Open WebUI" link).
PUBLIC_OLLAMA_WEBUI_URL=http://100.93.147.108:3000

SUPABASE_HOST=100.98.202.69
SUPABASE_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_URL=http://100.98.202.69:54321

# LAN-only fallback host that the supabase clients will rewrite to when
# SUPABASE_HOST is unreachable (kept for compatibility with the original code).
PUBLIC_SUPABASE_LEGACY_HOST=192.168.8.150

# Frontend node (Tailscale IP).  Used by vite HMR and the CSP allow-list.
FRONTEND_HOST=100.105.211.46
VITE_HMR_HOST=192.168.8.151


# ─── Supabase ─────────────────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL=http://reclame-supabase.local:8000
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the AI orchestrator's "dumb tool" raw-SQL path.
DATABASE_URL=postgresql://postgres:postgres@reclame-supabase.local:54322/postgres


# ─── Public app URLs ──────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://reclame-orch.local
PUBLIC_APP_URL=http://reclame-orch.local
PUBLIC_APP_NAME=OMS - Order Management System
# WebSocket target the SvelteKit dev proxy forwards `/ws` to.
PUBLIC_WS_URL=ws://reclame-supabase.local:54321


# ─── AI swarm (per CLAUDE.md "Multi-Agent AI Swarm") ──────────────────────────
# Each agent's model can be swapped without touching code.

ROUTER_MODEL=hf.co/mradermacher/c4ai-command-r7b-12-2024-abliterated-GGUF:Q4_K_M
REASONING_MODEL=deepseek-r1:14b
ENGINEER_MODEL=hf.co/ertghiu256/qwen-3-14b-code-and-math-reasoning-gguf:Q4_K_M
VISION_MODEL=llama3.2-vision

# Default chat model used by analyze-order, generate-description and the
# "Hands" path inside the orchestrator.
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:14b

# Embedding model used by both crawlers and the auto-embed Edge Function.
EMBED_MODEL=nomic-embed-text


# ─── Ollama tuning ────────────────────────────────────────────────────────────
# Per-request hard timeout for non-streaming Ollama calls.
OLLAMA_TIMEOUT_MS=60000
# Reachability probe timeout (ms) used by /api/health and /api/ai/health.
OLLAMA_PROBE_TIMEOUT_MS=3000
# How long Ollama keeps a model warm in VRAM after a request finishes.
# Server jobs use 5m; the Windows CAD workstation sets this to 0s
# (CLAUDE.md "Windows CAD Protection") so VRAM frees instantly between calls.
OLLAMA_KEEP_ALIVE=5m


# ─── Crawler / RAG ────────────────────────────────────────────────────────────
BRAND_CRAWLER_BASE_URL=https://reclamefabriek.eu


# ─── CSP allow-list (svelte.config.js) ────────────────────────────────────────
# Comma-separated list of origins added to connect-src ON TOP of "'self'".
# Leave empty to use the default list synthesised from OLLAMA_HOST/SUPABASE_HOST.
# CSP_CONNECT_SRC=http://100.93.147.108:11434,http://100.98.202.69:54321


# ─── Sentry (optional) ────────────────────────────────────────────────────────
PUBLIC_SENTRY_DSN=
SENTRY_DSN=


# ─── Email notifications (optional) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourcompany.com


# ─── Backups (scripts/backup.sh) ──────────────────────────────────────────────
# Encrypted nightly backups land here. Both must be set — the script exits 0
# without doing anything when either is missing.
# BACKUP_REMOTE_PATH=backup@reclame-nas:/mnt/oms-backups
# BACKUP_KEY=                  # 32-byte hex secret, e.g. `openssl rand -hex 32`


# ─── pg_cron auto-embed bridge ────────────────────────────────────────────────
# Set ONCE on the Postgres instance, NOT in this file:
#
#   ALTER DATABASE postgres
#       SET app.auto_embed_url            = 'http://reclame-supabase.local:54321/functions/v1/auto-embed';
#   ALTER DATABASE postgres
#       SET app.supabase_service_role_key = '<service-role-key>';
#
# Until both settings exist, the cron job runs but the inner http_post
# returns NULL and is silently skipped.


# ─── Notes ────────────────────────────────────────────────────────────────────
#  1. NEVER commit the populated .env — it's gitignored.
#  2. Variables starting with PUBLIC_ are exposed to the browser bundle.
#  3. Anything else is server-side only.
#  4. To rotate a Tailscale IP, edit OLLAMA_HOST / SUPABASE_HOST / FRONTEND_HOST.
#     Every consumer (orchestrator, tools, crawlers, CSP, health probes,
#     ai-dashboard WebUI link, Vite HMR) picks up the new value automatically.
