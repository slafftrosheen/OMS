{
  "name": "reclame-fabriek-mockup",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "dev:clean": "rm -rf .svelte-kit node_modules/.vite && vite dev --host",
    "build": "vite build",
    "build:clean": "rm -rf .svelte-kit node_modules/.vite build && vite build",
    "preview": "vite preview",
    "smoke-test": "vite build && vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "tsx tests/a11y/run-tests.ts",
    "test:contrast": "tsx tests/a11y/contrast-check.ts",
    "test:a11y:watch": "nodemon --watch src --exec npm run test:a11y",
    "migrate": "supabase db push",
    "migrate:status": "supabase migration list",
    "supabase:migrate:create": "bash scripts/supabase-migrate.sh create",
    "supabase:migrate:list": "bash scripts/supabase-migrate.sh list",
    "supabase:migrate:push": "bash scripts/supabase-migrate.sh push",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "docker:build": "docker build -t oms:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "crawler": "tsx src/workers/crawler/index.ts",
    "crawler:brand": "tsx src/workers/crawler/brand_crawler.ts",
    "ingestor": "tsx src/workers/ingestor/index.ts"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@sentry/node": "^8.0.0",
    "@sentry/sveltekit": "^8.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.90.1",
    "@sveltejs/kit": "^2.7.4",
    "@tldraw/tldraw": "^2.4.4",
    "@types/nodemailer": "^8.0.0",
    "apexcharts": "file:packages/apexcharts",
    "chart.js": "^4.4.0",
    "cheerio": "^1.0.0",
    "csv-writer": "1.6.0",
    "dayjs": "^1.11.18",
    "dotenv": "^16.4.5",
    "esbuild": "^0.21.5",
    "exceljs": "4.4.0",
    "ical-generator": "^10.0.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "^3.0.3",
    "lucide-svelte": "^0.462.0",
    "makerjs": "^0.19.2",
    "nodemailer": "^8.0.6",
    "pantone-colors": "^1.0.3",
    "pdfjs-dist": "^4.8.69",
    "pdfkit": "0.17.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.1.16",
    "svelte-apexcharts": "file:packages/svelte-apexcharts",
    "svelte-i18n": "file:packages/svelte-i18n",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "jsdom": "^27.4.0",
    "supabase": "^2.72.4",
    "svelte-check": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.10",
    "vitest": "file:packages/vitest"
  },
  "overrides": {
    "svelte-apexcharts": {
      "svelte": "^5.0.0"
    }
  }
}
