From 6df2131b0c795462861353255725155691298000 Mon Sep 17 00:00:00 2001
From: Qwen-Coder <qwen-coder@alibabacloud.com>
Date: Fri, 16 Jan 2026 14:31:00 +0200
Subject: [PATCH] fix: update svelte.config.js for Vercel deployment

- Change base path logic to properly handle Vercel deployments
- Set relative: false for better Vercel compatibility
- Default to empty base path for Vercel deployments

---
 svelte.config.js | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/svelte.config.js b/svelte.config.js
index 815732c..283533e 100644
--- a/svelte.config.js
+++ b/svelte.config.js
@@ -2,11 +2,11 @@ import adapter from '@sveltejs/adapter-vercel';
 import { vitePreprocess } from '@sveltejs/vite-plugin-svelte';
 
 const dev = process.env.NODE_ENV === 'development';
-const base = process.env.BASE_PATH || (dev ? '' : '/reclame_OMS');
+// Set base path based on environment variable, default to empty string for Vercel
+const base = process.env.BASE_PATH !== undefined ? process.env.BASE_PATH : (dev ? '' : '');
 
 /** @type {import('@sveltejs/kit').Config} */
 const config = {
   preprocess: vitePreprocess(),
   kit: {
     adapter: adapter({
       // See https://github.com/sveltejs/kit/tree/main/packages/adapter-vercel#configuration
       runtime: 'nodejs20.x', // Specify Node.js runtime
       regions: ['fra1'], // Optional: specify regions
     }),
-    paths: { base, relative: true },
+    paths: { base, relative: false }, // Changed relative to false for Vercel
     alias: {
       '$lib': 'src/lib',
       '$lib/*': 'src/lib/*'
     },
     prerender: {
       handleHttpError: 'warn',
       handleMissingId: 'warn',
       handleUnseenRoutes: 'warn'
     }
   }
 };
 
 export default config;